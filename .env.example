# Render provides PORT automatically. Use AI_CORE_PORT for local development.
AI_CORE_PORT=3000
FAKE_BACKEND_PORT=4000
# Public tunnel URL used in media links when AI Core runs outside this machine.
# FAKE_BACKEND_PUBLIC_URL=https://your-domain.ngrok-free.dev

BACKEND_BASE_URL=http://localhost:4000
BACKEND_CASE_PATH=/cases
BACKEND_RESULTS_PATH=/results
AI_CORE_BASE_URL=http://localhost:3000
BACKEND_SERVICE_TOKEN=dev-token

REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=

GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_IDENTITY_MODEL=openai/gpt-oss-120b
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3-turbo
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

POLICY_MIN_LENGTH=8
POLICY_MAX_LENGTH=20
NAME_MIN_LENGTH=2
IDENTITY_CONFIDENCE_THRESHOLD=0.7

MAX_IMAGE_BYTES=4194304
MAX_AUDIO_BYTES=26214400
MAX_DOCUMENT_BYTES=52428800
LOG_LEVEL=info
